// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  googleId   String?  @unique
  email      String   @unique
  name       String
  avatarUrl  String?
  passwordHash String?
  emailVerifiedAt DateTime?
  createdAt  DateTime @default(now())

  senders         Sender[]
  emails          Email[]
  storedAttachments StoredAttachment[]
  slackConnection SlackConnection?
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AuthToken {
  id        String           @id @default(cuid())
  email     String
  name      String?
  tokenHash String           @unique
  purpose   AuthTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([email, purpose, expiresAt])
}

model Sender {
  id           String   @id @default(cuid())
  userId       String
  fromEmail    String
  smtpHost     String
  smtpPort     Int
  smtpUser     String
  smtpPass     String
  hourlyLimit  Int?
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]
}

enum EmailStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model Email {
  id          String      @id @default(cuid())
  userId      String
  senderId    String
  toEmail     String
  subject     String
  body        String
  scheduledAt DateTime
  hourlyLimit Int?
  sentAt      DateTime?
  status      EmailStatus @default(SCHEDULED)
  attempts    Int         @default(0)
  sizeBytes   Int         @default(0)
  isStarred   Boolean     @default(false)
  messageId   String?
  error       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments EmailAttachment[]

  @@index([userId, status, scheduledAt])
  @@index([status, scheduledAt])
}

model StoredAttachment {
  id          String            @id @default(cuid())
  userId      String
  fileName    String
  contentType String
  sizeBytes   Int
  content     Bytes
  createdAt   DateTime          @default(now())
  emails      EmailAttachment[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailAttachment {
  emailId      String
  attachmentId String
  email        Email           @relation(fields: [emailId], references: [id], onDelete: Cascade)
  attachment   StoredAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@id([emailId, attachmentId])
  @@index([attachmentId])
}

model SlackConnection {
  id         String   @id @default(cuid())
  userId     String   @unique
  webhookUrl String
  channel    String
  teamName   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
