{
  "name": "reachinbox-scheduler",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "dotenv -e .env -- npm run migrate --workspace=packages/db",
    "db:generate": "dotenv -e .env -- npm run generate --workspace=packages/db",
    "dev:api": "dotenv -e .env -- npm run dev --workspace=apps/api",
    "dev:worker": "dotenv -e .env -- npm run dev --workspace=apps/worker",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/db && npm run build --workspace=apps/api && npm run build --workspace=apps/worker && npm run build --workspace=apps/web",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.15"
  }
}
