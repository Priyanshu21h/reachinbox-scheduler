# Application
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Security
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Generate 32 random bytes and base64-encode them. Keep this key stable; it encrypts SMTP and Slack credentials in the database.
CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
# Comma-separated Google account emails allowed to view/control Bull Board.
ADMIN_EMAILS=your.email@example.com
# Only configured outbound SMTP hostnames may be used (comma-separated).
SMTP_ALLOWED_HOSTS=smtp.ethereal.email
TRUST_PROXY_HOPS=0

# Database
DATABASE_URL=postgresql://rs:rs@localhost:5433/reachinbox

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ES_NODE=http://localhost:9200

# Worker settings
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_ATTEMPTS=3

# Google OAuth (required for login)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Redirect URI must match: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Optional SMTP account for email/password verification and password reset emails.
# Email/password auth returns a setup error until these are configured.
AUTH_EMAIL_SMTP_HOST=
AUTH_EMAIL_SMTP_PORT=587
AUTH_EMAIL_SMTP_USER=
AUTH_EMAIL_SMTP_PASS=
AUTH_EMAIL_FROM=

# Slack OAuth (required for Slack notifications)
# Create app at: https://api.slack.com/apps
# OAuth scope required: incoming-webhook
# Redirect URI must match: http://localhost:4000/slack/oauth/callback
SLACK_CLIENT_ID=REPLACE_WITH_YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=REPLACE_WITH_YOUR_SLACK_CLIENT_SECRET
SLACK_REDIRECT_URI=http://localhost:4000/slack/oauth/callback
# Generate 32 random bytes and base64-encode them; replace the example value.
SLACK_STATE_SECRET=REPLACE_WITH_BASE64_32_RANDOM_BYTES
